# Salin menjadi .env lalu ganti semua nilai "ganti-…" sebelum menjalankan docker compose.
POSTGRES_DB=tka
POSTGRES_USER=tka
POSTGRES_PASSWORD=ganti-password-database-yang-kuat
# kunci penanda token login; isi string acak panjang (mis. hasil: openssl rand -hex 48)
APP_SECRET=
# password awal akun superadmin (hanya dipakai saat database pertama kali dibuat)
SUPERADMIN_PASSWORD=
PORT_APP=3026
SEED_DEMO=0
